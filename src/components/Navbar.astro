---
import { type NavModel } from '@ts/Models'
interface Props {
  navItems: NavModel[];
}

const {navItems} = Astro.props;
---

<nav class="navbar is-transparent" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    <a role="button" class="navbar-burger" data-target="navMenu" aria-label="menu" aria-expanded="false">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>
  <div id="navMenu" class="navbar-menu">
    <div class="navbar-start is-grouped">
        {
            navItems.map((item) => (
                <a class="navbar-item box-shadow is-fullwidth is-medium m-2" href={item.path}>{item.title}</a>
            ))
        }
    </div>
  </div>
</nav>

<script>
  let burgerListener = () => {
    let $burger = document.querySelector('.navbar-burger')
        $burger.addEventListener('click', () => {
          document.getElementById("navMenu").classList.toggle('is-active');
        })
  }

  document.addEventListener('DOMContentLoaded', burgerListener)
  document.addEventListener("astro:after-swap", burgerListener)
</script>

<style lang="scss">
  :root {
    --navbar-item-bg: hsl(0, 0%, 96%); /* Similar to $background-light in Bulma */
  }

  .navbar-burger > span {
    height: 0.12em;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --navbar-item-bg: hsl(0, 0%, 14%); /* Approx. $background-dark */
    }
  }
  .navbar.is-transparent {
    background-color: transparent;
    box-shadow: none; /* optional: remove default shadow */
  }

  .navbar-item {
    background-color: var(--navbar-item-bg);
    transition: background-color 0.3s;
  }
</style>