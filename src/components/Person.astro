---
import { Icon } from 'astro-icon/components';
import AboutCard from '@components/AboutCard.astro'
import ImageBox from '@components/ImageBox.astro'

import markdownit from 'markdown-it';

import { type PersonModel } from '@ts/Models'

const md = markdownit();

interface Props {
  person: PersonModel;
  columns?: boolean;
}

const { person, columns = false} = Astro.props;

const iconSize = 20;

---
<AboutCard columns={columns}>
  <div class="fixed-grid">
    <div class="grid">
        {"photo" in person && 
        <div class="is-4 cell">
          <ImageBox src={person.photo} alt={"Photo of ".concat(person.name)} />
        </div>
        }
        <div class="is-8 cell">
          <p class="title is-4">{person.name}{person.creds && ", ".concat(person.creds.join(", "))}</p>
          <p class="subtitle is-4">{person.roles && person.roles.join(", ")}</p>
          <div class="tags are-medium">
            <p class="tag is-primary">
              <span class="mr-2 icon">
                <Icon name="mdi:person" size={iconSize} />
              </span>
              <span class="has-text-white">{person.pronouns}</span>
            </p>
            <p class="tag is-primary">
              <span class="mr-2 icon">
                <Icon name="mdi:email" size={iconSize} />
              </span>
              {person.email && <a class="has-text-white" href={"mailto:".concat(person.email)}>{person.email}</a>}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="block">
    <p set:html={md.renderInline(person.bio)}></p>
  </div>
  <div class="block">
    <div class="tags">
      {
        person.socials.map((platform) => (
          <div class="tag is-medium is-primary">
            <span class="icon mr-2">
              <Icon name={"mdi:".concat(platform.name.toLowerCase())} size={iconSize} />
            </span>
            <a class="has-text-white" href={platform.url}>{platform.user}</a>
          </div>
        ))
      }
    </div>
  </div>
</AboutCard>