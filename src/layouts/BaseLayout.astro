---
import { ClientRouter } from "astro:transitions";
import Header from '@components/Header.astro';
import Globe from '@components/Globe.astro';
import Footer from '@components/Footer.astro';

import { SEO } from "astro-seo";
import { getSecret } from 'astro:env/server';

import '../styles.scss';

interface Props {
  name: string;
}

const key = getSecret('PUBLIC_MAPBOX_KEY');

const { name } = Astro.props;

const navItems = [
    {
        title: "Home",
        path: "/",
    },
    {
        title: "About",
        path: "/about",
    },

]

import { type ConfigModel } from '@ts/Models'
import dataRaw from "@src/config.json";
const data:ConfigModel= dataRaw;

---
<!DOCTYPE html>
<html lang="en">
	<head>
		<SEO
			title=`${name}—MIT DUSP`
			description=`${data.description}`
			charset="UTF-8"
			canonical=`${Astro.url.href}`
			openGraph={{
				basic: {
					title: `MIT SAAARG—${data.subtitle}`,
					type: "website",
					image: "https://github.com/mit-spatial-action/.github/raw/refs/heads/main/logo/saarg-logo_purple-on-white-250px.png",
					url: `${Astro.url.href}`
				},
				optional: {
					description: `${data.description}`,
    				locale: "en_US",
					siteName: `${name}—MIT DUSP`
				}
			}}
		/>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
	</head>
	<body>
		<section class="section is-fullheight">
			<div class="container">
				<Header {navItems}/>
				<slot/>
			</div>
		</section>
		<Footer navItems = {navItems}, parent = {data.parent}/>
		<Globe
		transition:persist
		sec={data.map.sec}
		lat={data.map.lat} 
		lng={data.map.lng}
		zoom={data.map.zoom}
		style={data.map.style}
		bearing={data.map.bearing}
		pitch={data.map.pitch}
		linework={data.map.linework}
		light={data.map.light}
		linewidth={data.map.linewidth}
		interactive={data.map.interactive}
		accesstoken={key}/>
	</body>
</html>